# NEXT_PUBLIC_API_URL: The base URL for the backend API.
# Example for Render deployment: https://your-backend-app.onrender.com/api
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# NEXT_PUBLIC_WS_URL: The base WebSocket URL for the backend API.
# Example for Render deployment: wss://your-backend-app.onrender.com/api
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
