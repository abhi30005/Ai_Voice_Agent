APP_NAME=AI Voice Agent
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-string-for-production

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.eg7figo.mongodb.net/
MONGODB_DATABASE=ai_voice_agent

JWT_SECRET_KEY=generate-another-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=your-openai-api-key
gork_API_KEY=your-grok-api-key

STT_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id-here

# These are for when using a separate ChromaDB service, but currently the app uses a local persistent client
CHROMA_HOST=localhost
CHROMA_PORT=8000
